# Copiá este archivo como .env.local y completá con tus credenciales
# Las encontrás en: Supabase > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# URL de gounuri.com (sin barra final) — el botón "Cambiar de plan" de
# /dashboard/uso te manda ahí (el pago se hace en gounuri.com, no acá).
# Si falta, cae a https://gounuri.com por defecto.
NEXT_PUBLIC_GOUNURI_URL=https://gounuri.com

# Dominios propios de tenants (Configuración > Dominio) — Vercel > Account
# Settings > Tokens (scope: Full Account, o al menos los proyectos tienda-*)
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_iXqWFN1rtfa5rHbCYtOIDHH9

# Pool de widgets de Turnstile (mismo feature) — Cloudflare dashboard >
# My Profile > API Tokens > Create Token > permiso Account.Turnstile:Edit.
# CF_ACCOUNT_ID está en el dashboard de Cloudflare, barra derecha de cualquier
# sitio/cuenta.
CF_API_TOKEN=
CF_ACCOUNT_ID=
